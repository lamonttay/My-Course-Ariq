<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:orientation="vertical"
    tools:context=".HomeFragment">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/course_icon"
        android:contentDescription="Course image" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Praktikum Pemrograman Perangkat Bergerak"
        style="@style/CustomTextView18Bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp"
        android:layout_marginBottom="28dp"
        android:text="Ariq Muhammad - B1"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_materi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Materi"
        style="@style/CustomRoundedButton" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_quiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Quiz"
        style="@style/CustomRoundedButton" />

</LinearLayout>